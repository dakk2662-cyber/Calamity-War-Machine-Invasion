Items: {
	WulfrumSword: {
		DisplayName: Вульфрумовый меч
		Tooltip:
			'''
			Заряжается по мере нанесения урона врагу
			После полной зарядки позволяет совершить рывок на ПКМ
			[c/83B87E:'Огромный вульфрумовый меч!? Ещё и заряжается!?']
			[c/83B87E:'Конечно хочу!']
			'''
	}

	WulfrumPipe: {
		DisplayName: Вульфрумовая труба
		Tooltip: Бывшее танковое орудие
	}

	WulfrumLRocket: {
		DisplayName: Вульфрумовая ракета
		Tooltip:
			'''
			Не разрушает блоки
			[c/83B87E:'Самонаводится на противников']
			'''
	}

	WulfrumLuncher: {
		DisplayName: Вульфрумовый ракетомет
		Tooltip: "[c/83B87E:'Он намного мощнее чем вы думаете.']"
	}

	WulfrumTankBanner: {
		DisplayName: Знамя вульфрумового танка
		// Tooltip: ""
	}

	WulfrumWormBanner: {
		DisplayName: Знамя вульфрумового копателя
		// Tooltip: ""
	}

	WulfrumMothershipRelic: {
		DisplayName: Реликвия вульфрумового корабля-носителя
		// Tooltip: ""
	}

	WulfrumHeart: {
		Tooltip:
			'''
			Призывает вульфрумовый корабль-носитель
			Не расходуется
			'''
		DisplayName: Вульфрумовое сердце
	}

	WulfrumMothershipBag: {
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
		DisplayName: Вульфрумовая сфера
	}

	Lore: {
		LoreWulfrumMothership: {
			DisplayName: История (Вульфрумовый Носитель)
			Tooltip:
				'''
				Во время войны эти величественные машины были в отличном состоянии,
				имели мощную защиту и высокую маневренность, но время не щадит никого... 
				Несмотря на то, что вульфрумовые носители давно проржавели, это не мешает им и по сей день, 
				оставаться грозным противником, которого все так же защищают более простые вульфрумовые создания.
				'''
		}

		LoreWulfrumInvasion: {
			Tooltip:
				'''
				После того как ты уничтожил их корабль-носитель логично,
				что вульфрумовые машины разгневались и решили отомстить тебе;
				но так как ты это читаешь, видимо ты отразил их атаку.
				Но вульфрумовых машин ещё очень много, скорее всего ты с ними ещё встретишься...
				'''
			DisplayName: История (Вульфрумовое Нашествие)
		}
	}

	WulfrumBook: {
		DisplayName: Вульфрумовая книга
		Tooltip:
			'''
			Создает вульфрумовые машины используя ману
			[c/83B87E:'Сборка и эксплуатация вульфрумовых механизмов.]
			[c/83B87E:Что может быть круче?']
			'''
	}

	WulfrumStaff: {
		DisplayName: Вульфрумовый посох
		Tooltip:
			'''
			Призывает турель защищающую вас
			[c/83B87E:'Такая мощная и милая!]
			'''
	}

	WulfrumBomberBanner: {
		// Tooltip: ""
		DisplayName: Знамя вульфрумового бомбера
	}

	WulfrumBarrel: {
		Tooltip:
			'''
			Увеличивает весь урон игрока в %
			Каждые 15 секунд урон возрастает на 5%
			Максимально возможный бонус к урону - 20%
			При получении урона игроком бонус сбрасывается до 0%
			[c/83B87E:Вульфрумовая наука лучшая в мире!]
			'''
		DisplayName: Вульфрумовая бочка
	}

	WulfrumMothershipTrophy: {
		// Tooltip: ""
		DisplayName: Трофей вульфрумового носителя
	}

	UnstableBattery: {
		Tooltip:
			'''
			Начинает Вульфрумовое нашествие
			Вставте её в Вульфрумовую приманку
			[c/83B87E:Интересная батарейка...]
			'''
		DisplayName: Нестабильная батарейка
	}

	Weapons: {
		Rogue: {
			WulfrumJavelin: {
				Tooltip:
					'''
					Копья наносят урон по площади
					При скытном ударе, копье летит прямо и быстро
					[c/83B87E:Почувствуй себя Вульфрумовым спартанцем!]
					'''
				DisplayName: Вульфрумовое копьё
			}
		}
	}

	WDAS: {
		Tooltip:
			'''
			[c/83B87E:Режим атаки:]
			Вокруг игрока появляются вульфрумовые осколки
			Интервал появления осколков - 1.5 секунды
			Максимум может появиться до 4-х штук
			При виде противника направляются к нему и наносят урон
			[c/42F5F1:Режим защиты:]
			Увеличивает защиту игрока на 5
			[c/83B87E:Расшифровка: Вульфрумовая оборонительно-боевая система.]
			'''
		DisplayName: В.О.Б.С.
		KeybindInfo: Нажмите {0} чтобы изменить состяние аксессуара
	}

	WulfrumJumperTrophy: {
		// Tooltip: ""
		DisplayName: Трофей вульфрумового прыгуна
	}

	WulfrumJumperRelic: {
		// Tooltip: ""
		DisplayName: Реликвия вульфрумового прыгуна
	}

	WulfrumPrototypeItem: {
		DisplayName: Вульфрумовый чертеж
		Tooltip:
			'''
			Призывает вульфрумовый прототип
			Прототип быстро передвигается и может делать рывки
			[c/83B87E:Какой же он няшный)]
			'''
	}

	WulfrumInvasionMusicBox: {
		DisplayName: Wulfrum Invasion (Music Box)
		Tooltip: By - Spozmotosm
	}

	MechanismWarfareMusicBox: {
		Tooltip: By - Digidonix
		DisplayName: Mechanism Warfare (Music Box)
	}
}

NPCs: {
	WulfrumTank: {
		DisplayName: Вульфрумовый танк
		Bestiary: Бронированный патрульный танк из сплава вульфрума. Хотя данные машины были довольно просты, в тоже время они были очень эффективны на поле битвы.
	}

	WulfrumWormBody.DisplayName: Вульфрумовый копатель

	WulfrumWormHead: {
		DisplayName: Вульфрумовый копатель
		Bestiary: Данные вульфрумовые копатели использовались для того чтобы быстро прорывать тоннели сквозь скалы, но когда началась война, высокая защита и скорость превратили их в грозных противников.
	}

	WulfrumWormTail.DisplayName: Вульфрумовый копатель

	WulfrumMothership: {
		DisplayName: Вульфрумовый носитель
		Bestiary: Огромный вульфрумовый корабль-носитель, координирующий действия вульфрумовых машин. Вооружен самонаводящимися ракетами и имеет мини-завод внутри себя. Заряжает другие вульфрумовые машины.
		SpawnInfo: Используй [i:CalamityAddon/WulfrumHeart] днём на поверхности.
		DespawnMessage: Вульфрумовый Носитель потерял к вам интререс...
	}

	WulfrumShield.DisplayName: Вульфрумовый носитель

	WulfrumBomber: {
		DisplayName: Вульфрумовый бомбер
		Bestiary: Изначально вульфрумовые бомберы предназначались для перевозки различных тяжелых грузов по воздуху, но когда началась война их легко переоборудовали под транспортировку и сброс небольших бомб. При их появлении противник обращался в бегство.
	}

	WulfrumJumperP1.DisplayName: Вульфрумовый прыгун

	WulfrumJumperP2: {
		DisplayName: Вульфрумовый прыгун
		Bestiary: Эти машины были специально разработаны что бы устраивать засады на армию Ярима в горной местности. Их ракетные установки уничтожали основную часть вражеских войск, а союзные вульфрумовые роботы без труда настигали уцелевших противников.
	}
}

Projectiles: {
	WulfrumRocket.DisplayName: Вульфрумовая ракета
	WulfrumLRocketProj.DisplayName: Вульфрумовая ракета
	WulfrumMachineProj.DisplayName: Вульфрумовая машина
	WulfrumTurret.DisplayName: Вульфрумовая турель
	WulfrumMinis.DisplayName: Вульфрумовая мина
	WulfrumBigis.DisplayName: Вульфрумовая мина
	WulfrumJavelinProj.DisplayName: Вульфрумовое копьё
	WDASShard.DisplayName: Вульфрумовый осколок
	WulfrumShockwave.DisplayName: Вульфрумовый прыгун
}

Buffs: {
	WulfrumTurretBuff: {
		DisplayName: Вульфрумовая турель
		Description: Вас защищает вульфрумовая турель
	}

	WulfrumPrototypeBuff: {
		Description: Мини-прототип танка
		DisplayName: Вульфрумовый прототип
	}
}

Mods: {
	CalamityAddon: {
		Events: {
			WulfrumRush: {
				InvasionName: Вульфрумовое нашествие
				SpawnInfo: Нажмите ПКМ по [i:CalamityMod/WulfrumLureItem] имея [i:CalamityAddon/UnstableBattery] в инвентаре.
			}
		}
	}
}

Keybinds.WDASKeybind.DisplayName: Смена режима В.О.Б.С.

